---
import DocsLayout from '../../layouts/DocsLayout.astro'
import '@wsagency/wseffect-themes/css/select.css'
import '@wsagency/wseffect-themes/css/dialog.css'
import '@wsagency/wseffect-themes/css/tabs.css'
import '@wsagency/wseffect-themes/css/data-table.css'
import { galleryMappings } from '../../data/gallery-mappings'
import '@wsagency/wseffect-themes/css/text-field.css'
---
<DocsLayout title="Interactive component demos" description="Interactive Foldkit Runtime.embed examples for Select, Dialog, Tabs, DataTable, and shared Themes settings." canonical="https://wseffect.com/demos/">
  <p class="eyebrow">Live programs · Runtime.embed</p>
  <h1>Components in motion.</h1>
  <p class="lede">These controls are running real Foldkit programs—not static mockups. Each island owns its model and messages while reusing this page’s single Theme and portal root.</p>
  <div class="callout"><p><strong>Try the interactions:</strong> choose Blue in the Select, open and dismiss the dialog with Escape, navigate tabs with the keyboard, sort or select table rows, then change this page’s shared Theme settings.</p></div>
  <div class="demo-grid">
    <section class="demo-panel" id="controls-title" aria-labelledby="controls-heading">
      <h2 id="controls-heading">Model-driven TextField</h2>
      <div class="demo-panel__body"><p>Type into a real Themes TextField backed by a Foldkit model.</p><div data-island="controls" aria-label="TextField demo"></div></div>
    </section>
    <section class="demo-panel" aria-labelledby="select-title">
      <h2 id="select-title">Select and popover</h2>
      <div class="demo-panel__body"><p>A model-driven Select with a portaled popper and announced selected value.</p><div data-island="select" aria-label="Select demo"></div></div>
    </section>
    <section class="demo-panel" aria-labelledby="dialog-title">
      <h2 id="dialog-title">Dialog and focus</h2>
      <div class="demo-panel__body"><p>Open the modal, then press Escape. Focus returns to the invoking button.</p><div data-island="dialog" aria-label="Dialog demo"></div></div>
    </section>
    <section class="demo-panel" aria-labelledby="tabs-title">
      <h2 id="tabs-title">Keyboard tabs</h2>
      <div class="demo-panel__body"><p>Use arrow keys to move between tabs and Home or End to jump to a boundary.</p><div data-island="tabs" aria-label="Tabs demo"></div></div>
    </section>
    <section class="demo-panel" id="data-table-title" aria-labelledby="table-title">
      <h2 id="table-title">Interactive data table</h2>
      <div class="demo-panel__body"><p>Sort columns and select rows in a small, real DataTable model.</p><div data-island="table" aria-label="Data table demo"></div></div>
    </section>
    <section class="demo-panel" aria-labelledby="theme-title">
      <h2 id="theme-title">Shared Theme settings</h2>
      <div class="demo-panel__body"><p>These settings update the page Theme generated by Themes.view. No second Theme root is mounted.</p><div data-island="theme-panel" aria-label="Shared Theme settings"></div></div>
    </section>
  </div>
  <section class="demo-attribution" aria-labelledby="demo-attribution-title">
    <h2 id="demo-attribution-title">Gallery provenance</h2>
    <p>Each example points to its canonical, tag-pinned Gallery source and its destination in this page. The provenance mappings are still in review.</p>
    <ul>
      {galleryMappings.map((mapping) => <li>
        <a href={mapping.sourceUrl}>Gallery source: {mapping.id}</a>
        <p>{mapping.description}</p>
        <a href={mapping.demoRoute}>View {mapping.id} demo</a>
      </li>)}
    </ul>
  </section>
</DocsLayout>
<script>
  import { mountIsland, type IslandEntry } from '../../islands/embed'
  import { textFieldEntry } from '../../islands/text-field-demo'
  import { selectEntry } from '../../islands/select-demo'
  import { dialogEntry } from '../../islands/dialog-demo'
  import { tabsEntry } from '../../islands/tabs-demo'
  import { tableEntry } from '../../islands/table-demo'
  import { themePanelEntry } from '../../islands/theme-panel'

  const entries: Record<string, IslandEntry> = {
    controls: textFieldEntry, select: selectEntry, dialog: dialogEntry, tabs: tabsEntry,
    table: tableEntry, 'theme-panel': themePanelEntry,
  }
  document.querySelectorAll<HTMLElement>('[data-island]').forEach((host) => {
    const name = host.dataset.island
    const entry = name ? entries[name] : undefined
    if (entry) mountIsland(host, entry)
  })
</script>
