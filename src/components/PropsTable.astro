---
import type { PropsRow } from '../../scripts/props';

type Props = {
  rows: ReadonlyArray<PropsRow>;
  sourceExport: string;
  sourceUrl: string;
};

const { rows, sourceExport, sourceUrl } = Astro.props;
---

<table class="props-table">
  <caption>
    Props exported by <code>{sourceExport}</code> · <a href={sourceUrl}>source</a>
  </caption>
  <thead>
    <tr>
      <th scope="col">Name</th>
      <th scope="col">Type</th>
      <th scope="col">Required</th>
      <th scope="col">Choices</th>
      <th scope="col">Description</th>
    </tr>
  </thead>
  <tbody>
    {rows.map((row) => (
      <tr>
        <th scope="row"><code>{row.name}</code></th>
        <td><code>{row.type}</code></td>
        <td>{row.required ? 'Yes' : 'No'}</td>
        <td>{row.choices?.length ? row.choices.join(', ') : '—'}</td>
        <td>{row.description ?? '—'}</td>
      </tr>
    ))}
  </tbody>
</table>
